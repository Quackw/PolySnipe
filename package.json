{
  "name": "poly-snipe-bot",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:components": "node --test --test-concurrency=1 components/holy-snipe-fast/*.test.mjs components/snipe-rtds-resilient/*.test.mjs components/snipe-v3-combined/*.test.mjs components/snipe-b-receiver/ops/snipe-v3-combined/*.test.mjs components/snipe-b-receiver/ops/snipe-v3-readiness/*.test.mjs",
    "test:all": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run test:components"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "grammy": "^1.38.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  },
  "description": "Polymarket wallet activity alerts with a durable queue and dual-input RTDS components"
}
