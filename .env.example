TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_USER_IDS=
SQLITE_PATH=./state/poly-snipe.db
SCHEDULER_TICK_MS=250
POLL_TARGET_INTERVAL_SEC=5
ACTIVITY_SAFE_RPS=20
ACTIVITY_CONCURRENCY=8
ACTIVITY_PAGE_LIMIT=500
ACTIVITY_MAX_PAGES=3
ACTIVITY_OVERLAP_SEC=2
# Set to 0 to disable skipping an exhausted V1 activity window.
V1_PAGE_BUDGET_RESYNC_AFTER=3
REBALANCE_EVERY_MS=5000
ORPHAN_CLEANUP_EVERY_MS=60000
SUBSCRIBE_MODE_TTL_MS=600000
STALE_INFLIGHT_AFTER_MS=60000
STALE_INFLIGHT_RECOVERY_EVERY_MS=30000
WAL_CHECKPOINT_EVERY_MS=600000
HEARTBEAT_EVERY_MS=60000
ALERT_DELAY_THRESHOLD_SEC=30
ALERT_SEND_CONCURRENCY=1
# Set to 0 to disable removal after consecutive permanent chat rejections.
PRUNE_BLOCKED_CHAT_AFTER_REJECTS=3
POLL_RUNS_RETENTION_HOURS=72
POLYMARKET_TIMEOUT_MS=10000
POLYMARKET_RETRIES=1
TELEGRAM_TIMEOUT_MS=5000
# Legacy shared HTTP fallbacks. New installs should prefer POLYMARKET_* and TELEGRAM_TIMEOUT_MS.
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
DEBUG=0
